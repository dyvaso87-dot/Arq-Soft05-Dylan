<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora Core Cyber</title>
    <style>
            body {
                background-color: #0d0d11;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                margin: 0;
                font-family: 'Courier New', Courier, monospace;
            }

            .calc-card {
                background-color: #121214;
                border: 3px solid #00ff66;
                border-radius: 12px;
                box-shadow: 0 0 20px rgba(0, 255, 102, 0.2);
                padding: 30px;
                width: 100%;
                max-width: 400px;
            }

            .calc-header h3 {
                color: #00ff66;
                text-align: center;
                letter-spacing: 2px;
                margin-top: 0;
                margin-bottom: 25px;
                text-shadow: 0 0 8px rgba(0, 255, 102, 0.5);
            }

            .calc-label {
                color: #888894;
                font-size: 0.85rem;
                font-weight: bold;
                display: block;
                margin-bottom: 5px;
            }

            .calc-input {
                background-color: #1a1a1e;
                border: 2px solid #33333a;
                color: #ffffff;
                font-family: monospace;
                font-size: 1rem;
                border-radius: 6px;
                padding: 10px;
                width: 94%;
                margin-bottom: 15px;
            }

                .calc-input:focus {
                    border-color: #00ff66;
                    outline: none;
                }

            select.calc-input {
                width: 100%;
            }

            .btn-calc-execute {
                background-color: #00ff66;
                border: none;
                border-radius: 6px;
                color: #000000;
                font-family: 'Courier New', Courier, monospace;
                font-weight: bold;
                font-size: 1.1rem;
                padding: 12px;
                width: 100%;
                cursor: pointer;
                transition: all 0.2s ease;
                box-shadow: 0 4px 12px rgba(0, 255, 102, 0.3);
            }

                .btn-calc-execute:hover {
                    background-color: #00cc52;
                    transform: translateY(-1px);
                }

            .calc-screen-result {
                background-color: #0a0a0c;
                border-left: 4px solid #00ff66;
                padding: 15px;
                border-radius: 4px;
                margin-top: 20px;
            }

            .screen-title {
                color: #555562;
                font-size: 0.8rem;
                display: block;
            }

            .screen-value {
                color: #00ff66;
                font-size: 2rem;
                font-weight: bold;
                text-shadow: 0 0 5px rgba(0, 255, 102, 0.4);
                margin-top: 5px;
                word-wrap: break-word;
            }
    </style>
</head>
<body>

    <div class="calc-card">
        <div class="calc-header">
            <h3>⚡ CALCULADORA CORE ⚡</h3>
        </div>
    
        <label class="calc-label">OPERANDO A</label>
        <input type="number" id="num1" class="calc-input" value="0">

        <label class="calc-label">OPERANDO B</label>
        <input type="number" id="num2" class="calc-input" value="0">

        <label class="calc-label">OPERACIÓN SYSTEM</label>
        <select id="operacion" class="calc-input">
            <option value="sumar">➕ SUMAR</option>
            <option value="restar">➖ RESTAR</option>
            <option value="multiplicar">✖️ MULTIPLICAR</option>
            <option value="dividir">➗ DIVIDIR</option>
        </select>

        <button type="button" onclick="ejecutarOperacion()" class="btn-calc-execute">EJECUTAR OPERACIÓN</button>

        <div class="calc-screen-result">
            <span class="screen-title">OUTPUT SYSTEM:</span>
            <div id="resultado" class="screen-value">0</div>
        </div>
    </div>

    <script>
            async function ejecutarOperacion() {
                const a = document.getElementById('num1').value;
                const b = document.getElementById('num2').value;
                const op = document.getElementById('operacion').value;
                const pantalla = document.getElementById('resultado');

                try {
                    // JavaScript consume la API de tu calculadora usando la URL relativa
                    const response = await fetch(`/api/calculadora/${op}?a=${a}&b=${b}`);
                    const data = await response.json();

                    if (response.ok) {
                        pantalla.style.color = "#00ff66";
                        // Accedemos a la propiedad 'resultado' que devuelve tu JSON
                        pantalla.innerText = data.resultado;
                    } else {
                        pantalla.style.color = "#ff3333";
                        pantalla.innerText = data.error || "Error";
                    }
                } catch (err) {
                    pantalla.style.color = "#ff3333";
                    pantalla.innerText = "ERROR API";
                }
            }
    </script>

</body>
</html>